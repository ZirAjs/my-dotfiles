// Reference-only Niri fragment containing changes made to the packaged default.
// This repository does not install or link Niri. Copy the parts you still want
// into your active Niri configuration and adjust output names per machine.

input {
    keyboard {
        xkb {
            layout "us"
            options "korean:ralt_hangul"
        }
    }
}

output "HDMI-A-1" {
    position x=0 y=0
    transform "normal"
}

output "eDP-1" {
    position x=1200 y=0
}

spawn-at-startup "fcitx5" "-d"
spawn-at-startup "noctalia"

// Run this once from a shell instead of on every Niri startup:
// xdg-mime default org.pwmt.zathura.desktop application/pdf

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

binds {
    Mod+Space hotkey-overlay-title="Open the Noctalia Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Open the Noctalia Control Center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+P hotkey-overlay-title="Niri Monitor" { spawn "noctalia" "msg" "panel-toggle" "zirajs/niri-monitor:panel"; }
    Alt+Tab hotkey-overlay-title="Open the Noctalia Window Switcher" { spawn "noctalia" "msg" "window-switcher"; }
    Mod+E hotkey-overlay-title="Open File Browser: yazi" { spawn "alacritty" "-e" "env" "EDITOR=nvim" "VISUAL=nvim" "yazi"; }
    Super+Alt+L hotkey-overlay-title="Lock Session" { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+S hotkey-overlay-title="Capture Region" { spawn "noctalia" "msg" "screenshot-region"; }
    Ctrl+Alt+Delete { spawn "noctalia" "msg" "panel-toggle" "session"; }
}
